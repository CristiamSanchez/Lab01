---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Hamburger Rapid &bull; Gourmet Fast-Food Experience</title>
  
  <meta name="description" content="Plataforma comercial de comida rápida gourmet. Catálogo de hamburguesas artesanal de carne Angus, pan brioche horneado a diario y estilo visual premium inspirado en Hamburgesin UI." />
  <meta name="theme-color" content="#0c0c0e" />
  <meta name="color-scheme" content="dark" />
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <style>
    /* =========================================================
       PALETA DE COLORES Y VARIABLES VISUALES "HAMBURGESIN UI"
       Inspirado en assets/Hamburgesin.png:
       - Fondo: Deep Obsidian / Charcoal Black (#0c0c0e)
       - Superficies y Cards: Dark Graphite (#18181c / #1f1f24)
       - Color Primario: Vibrant Warm Orange (#ff5722 / #ff6434)
       - Contraste Secundario: Crisp White (#ffffff)
       - Textos: White (#ffffff) & Warm Silver (#9ca3af)
       - Elementos: Botones Pill (9999px), Buscador Blanco Pill, Indicadores Dot (●)
       ========================================================= */
    :root {
      --bg-main: #0c0c0e;
      --bg-surface: #18181c;
      --bg-surface-elevated: #222228;
      --bg-surface-subtle: #2b2b34;
      --border-dark: rgba(255, 255, 255, 0.08);
      --border-focus: rgba(255, 87, 34, 0.45);
      
      --primary-orange: #ff5722;
      --primary-orange-hover: #f4511e;
      --primary-orange-glow: rgba(255, 87, 34, 0.35);
      --primary-orange-subtle: rgba(255, 87, 34, 0.14);
      
      --pill-white-bg: #ffffff;
      --pill-white-text: #0c0c0e;
      
      --text-white: #ffffff;
      --text-muted: #9ca3af;
      --text-dim: #6b7280;
      
      --radius-pill: 9999px;
      --radius-card: 22px;
      --radius-sm: 14px;
      
      --shadow-card: 0 10px 30px -10px rgba(0, 0, 0, 0.6), 0 0 1px 1px rgba(255, 255, 255, 0.05);
      --shadow-orange: 0 10px 28px -6px rgba(255, 87, 34, 0.4);
      --shadow-pill: 0 6px 20px rgba(0, 0, 0, 0.35);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }
    
    body {
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
      background-color: var(--bg-main);
      color: var(--text-white);
      line-height: 1.6;
      overflow-x: hidden;
      -webkit-font-smoothing: antialiased;
    }

    /* Indicador Circular Naranja (Estilo clave de Hamburgesin.png) */
    .dot-indicator {
      display: inline-block;
      width: 10px;
      height: 10px;
      background-color: var(--primary-orange);
      border-radius: 50%;
      margin-left: 8px;
      box-shadow: 0 0 10px var(--primary-orange-glow);
      vertical-align: middle;
    }

    /* Cinta Superior de Anuncios */
    .promo-ribbon {
      background: linear-gradient(90deg, #18181c, #261612, #18181c);
      border-bottom: 1px solid rgba(255, 87, 34, 0.25);
      color: var(--text-white);
      text-align: center;
      padding: 9px 16px;
      font-size: 0.85rem;
      font-weight: 700;
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 12px;
    }
    .promo-pill-badge {
      background: var(--primary-orange);
      color: #ffffff;
      padding: 3px 10px;
      border-radius: var(--radius-pill);
      font-size: 0.72rem;
      text-transform: uppercase;
      font-weight: 800;
      letter-spacing: 0.04em;
    }

    /* Header & Navegación Translúcida */
    header {
      background: rgba(12, 12, 14, 0.88);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
      border-bottom: 1px solid var(--border-dark);
      position: sticky;
      top: 0;
      z-index: 100;
      transition: all 0.3s ease;
    }
    .nav-container {
      max-width: 1260px;
      margin: 0 auto;
      padding: 16px 24px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
    }
    .brand {
      display: flex;
      align-items: center;
      gap: 12px;
      text-decoration: none;
      color: var(--text-white);
    }
    .brand-logo-emblem {
      width: 44px;
      height: 44px;
      background: #ffffff;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.5rem;
      box-shadow: 0 4px 14px rgba(255, 87, 34, 0.3);
      flex-shrink: 0;
    }
    .brand-text h1 {
      font-size: 1.35rem;
      font-weight: 800;
      letter-spacing: -0.02em;
      color: var(--text-white);
      line-height: 1.1;
    }
    .brand-text span {
      font-size: 0.72rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--primary-orange);
    }
    .nav-links {
      display: flex;
      align-items: center;
      gap: 26px;
    }
    .nav-link {
      text-decoration: none;
      color: var(--text-muted);
      font-weight: 600;
      font-size: 0.92rem;
      transition: color 0.2s;
    }
    .nav-link:hover {
      color: var(--primary-orange);
    }
    .nav-actions {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    /* Botones Pill de Referencia */
    .btn-pill-white {
      background: var(--pill-white-bg);
      color: var(--pill-white-text);
      text-decoration: none;
      padding: 10px 22px;
      border-radius: var(--radius-pill);
      font-size: 0.88rem;
      font-weight: 800;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      border: none;
      cursor: pointer;
      transition: all 0.2s ease;
      box-shadow: var(--shadow-pill);
    }
    .btn-pill-white:hover {
      background: #f4f4f5;
      transform: translateY(-2px);
      box-shadow: 0 8px 24px rgba(255, 255, 255, 0.25);
    }

    .btn-pill-orange {
      background: var(--primary-orange);
      color: #ffffff;
      text-decoration: none;
      padding: 11px 24px;
      border-radius: var(--radius-pill);
      font-size: 0.92rem;
      font-weight: 800;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      border: none;
      cursor: pointer;
      transition: all 0.25s ease;
      box-shadow: var(--shadow-orange);
    }
    .btn-pill-orange:hover {
      background: var(--primary-orange-hover);
      transform: translateY(-2px);
      box-shadow: 0 14px 30px rgba(255, 87, 34, 0.5);
    }

    .btn-pill-subtle {
      background: var(--bg-surface-subtle);
      color: var(--text-white);
      text-decoration: none;
      padding: 10px 20px;
      border-radius: var(--radius-pill);
      font-size: 0.88rem;
      font-weight: 700;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      border: 1px solid var(--border-dark);
      cursor: pointer;
      transition: all 0.2s ease;
    }
    .btn-pill-subtle:hover {
      background: #363640;
      border-color: rgba(255, 255, 255, 0.2);
      transform: translateY(-2px);
    }

    /* Hero Section con Visual Dark */
    .hero {
      padding: 70px 24px 60px;
      max-width: 1260px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: 1.15fr 0.85fr;
      align-items: center;
      gap: 56px;
    }
    .hero-badge-row {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: var(--primary-orange-subtle);
      border: 1px solid rgba(255, 87, 34, 0.35);
      color: var(--primary-orange);
      padding: 7px 16px;
      border-radius: var(--radius-pill);
      font-size: 0.8rem;
      font-weight: 800;
      margin-bottom: 22px;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }
    .hero-title {
      font-size: 3.5rem;
      font-weight: 800;
      line-height: 1.12;
      letter-spacing: -0.03em;
      margin-bottom: 22px;
      color: var(--text-white);
    }
    .hero-title .highlight-orange {
      color: var(--primary-orange);
      text-shadow: 0 0 25px rgba(255, 87, 34, 0.3);
    }
    .hero-desc {
      font-size: 1.15rem;
      color: var(--text-muted);
      line-height: 1.7;
      margin-bottom: 34px;
      max-width: 580px;
    }
    .hero-stats-row {
      display: flex;
      flex-wrap: wrap;
      gap: 14px;
      margin-bottom: 36px;
    }
    .stat-pill {
      display: flex;
      align-items: center;
      gap: 8px;
      background: var(--bg-surface);
      border: 1px solid var(--border-dark);
      padding: 9px 18px;
      border-radius: var(--radius-pill);
      font-size: 0.86rem;
      font-weight: 700;
      color: #e4e4e7;
    }
    .hero-actions-row {
      display: flex;
      gap: 16px;
      flex-wrap: wrap;
    }

    /* Hero Mockup estilo Teléfono Hamburgesin.png */
    .hero-phone-mockup {
      position: relative;
      background: var(--bg-surface);
      border: 6px solid #27272e;
      border-radius: 40px;
      padding: 20px;
      box-shadow: 0 30px 80px -15px rgba(0, 0, 0, 0.9), 0 0 40px rgba(255, 87, 34, 0.15);
      overflow: hidden;
      max-width: 420px;
      margin: 0 auto;
    }
    .mockup-top-notch {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 16px;
      padding: 0 6px;
      font-size: 0.75rem;
      color: var(--text-muted);
      font-weight: 700;
    }
    .mockup-hero-img-box {
      border-radius: 20px;
      overflow: hidden;
      aspect-ratio: 16 / 10;
      position: relative;
      margin-bottom: 16px;
      background: #202026;
    }
    .mockup-hero-img-box img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
    .mockup-badge {
      position: absolute;
      top: 10px;
      left: 10px;
      background: rgba(12, 12, 14, 0.85);
      border: 1px solid rgba(255, 87, 34, 0.4);
      color: var(--primary-orange);
      padding: 4px 10px;
      border-radius: var(--radius-pill);
      font-size: 0.72rem;
      font-weight: 800;
    }
    .mockup-section-title {
      font-size: 1rem;
      font-weight: 800;
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 12px;
      color: var(--text-white);
    }
    .mockup-quick-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 10px;
      margin-bottom: 16px;
    }
    .mockup-quick-card {
      background: #202026;
      border: 1px solid var(--border-dark);
      border-radius: 14px;
      padding: 10px 8px;
      text-align: center;
    }
    .mockup-quick-card img {
      width: 48px;
      height: 48px;
      border-radius: 10px;
      object-fit: cover;
      margin: 0 auto 6px;
      display: block;
    }
    .mockup-quick-card span {
      font-size: 0.7rem;
      font-weight: 700;
      display: block;
      color: var(--text-white);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .mockup-quick-card .price {
      color: var(--primary-orange);
      font-weight: 800;
      font-size: 0.75rem;
    }
    .mockup-actions-footer {
      display: flex;
      gap: 8px;
    }

    /* Buscador Blanco Pill de Referencia (Pantalla 3 Hamburgesin.png) */
    .search-section-wrap {
      max-width: 1260px;
      margin: 20px auto 40px;
      padding: 0 24px;
    }
    .search-pill-container {
      background: #ffffff;
      border-radius: var(--radius-pill);
      padding: 10px 24px;
      display: flex;
      align-items: center;
      gap: 14px;
      max-width: 680px;
      margin: 0 auto;
      box-shadow: 0 12px 35px rgba(0, 0, 0, 0.5), 0 0 20px rgba(255, 87, 34, 0.2);
      transition: all 0.25s;
    }
    .search-pill-container:focus-within {
      box-shadow: 0 14px 40px rgba(255, 87, 34, 0.35);
      outline: 2px solid var(--primary-orange);
    }
    .search-pill-container input {
      border: none;
      outline: none;
      background: transparent;
      font-size: 1rem;
      color: #111827;
      font-weight: 600;
      width: 100%;
      font-family: inherit;
    }
    .search-pill-container input::placeholder {
      color: #9ca3af;
      font-weight: 500;
    }
    .search-icon-btn {
      color: var(--primary-orange);
      font-size: 1.25rem;
      line-height: 1;
    }
    .clear-search-btn {
      background: #e5e7eb;
      border: none;
      color: #4b5563;
      border-radius: 50%;
      width: 22px;
      height: 22px;
      display: none;
      align-items: center;
      justify-content: center;
      font-size: 0.75rem;
      cursor: pointer;
      font-weight: 800;
    }

    /* Section General Styles */
    section {
      padding: 80px 24px;
      max-width: 1260px;
      margin: 0 auto;
    }
    .section-header {
      text-align: center;
      max-width: 760px;
      margin: 0 auto 50px;
    }
    .section-pill-tag {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: var(--primary-orange-subtle);
      border: 1px solid rgba(255, 87, 34, 0.3);
      color: var(--primary-orange);
      padding: 5px 16px;
      border-radius: var(--radius-pill);
      font-size: 0.8rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 14px;
    }
    .section-title {
      font-size: 2.7rem;
      font-weight: 800;
      letter-spacing: -0.02em;
      color: var(--text-white);
      line-height: 1.2;
      margin-bottom: 14px;
    }
    .section-subtitle {
      font-size: 1.1rem;
      color: var(--text-muted);
    }

    /* Filtros Pill de Categorías */
    .filter-pills-bar {
      display: flex;
      justify-content: center;
      gap: 12px;
      margin-bottom: 40px;
      flex-wrap: wrap;
    }
    .filter-pill-btn {
      background: var(--bg-surface);
      border: 1px solid var(--border-dark);
      padding: 10px 24px;
      border-radius: var(--radius-pill);
      font-size: 0.92rem;
      font-weight: 700;
      color: var(--text-muted);
      cursor: pointer;
      transition: all 0.25s ease;
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }
    .filter-pill-btn:hover {
      background: var(--bg-surface-elevated);
      color: var(--text-white);
      border-color: rgba(255, 255, 255, 0.2);
    }
    .filter-pill-btn.active {
      background: var(--primary-orange);
      color: #ffffff;
      border-color: var(--primary-orange);
      box-shadow: 0 4px 18px var(--primary-orange-glow);
    }

    /* Grid de Catálogo de 10 Hamburguesas */
    .catalog-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(330px, 1fr));
      gap: 30px;
    }
    .burger-card {
      background: var(--bg-surface);
      border: 1px solid var(--border-dark);
      border-radius: var(--radius-card);
      overflow: hidden;
      box-shadow: var(--shadow-card);
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
      display: flex;
      flex-direction: column;
      position: relative;
    }
    .burger-card:hover {
      transform: translateY(-8px);
      border-color: var(--border-focus);
      box-shadow: 0 20px 40px -10px rgba(0, 0, 0, 0.8), 0 0 25px rgba(255, 87, 34, 0.2);
    }
    .card-img-wrap {
      position: relative;
      aspect-ratio: 16 / 11;
      overflow: hidden;
      background: #1c1c22;
    }
    .card-img-wrap img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.5s ease;
    }
    .burger-card:hover .card-img-wrap img {
      transform: scale(1.07);
    }
    .specialty-badge {
      position: absolute;
      top: 14px;
      left: 14px;
      background: rgba(12, 12, 14, 0.88);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      color: #ff9800;
      border: 1px solid rgba(255, 152, 0, 0.4);
      padding: 5px 14px;
      border-radius: var(--radius-pill);
      font-size: 0.78rem;
      font-weight: 800;
      z-index: 2;
    }
    .rating-badge {
      position: absolute;
      top: 14px;
      right: 14px;
      background: rgba(12, 12, 14, 0.88);
      color: #fbbf24;
      backdrop-filter: blur(8px);
      padding: 4px 10px;
      border-radius: var(--radius-pill);
      font-size: 0.76rem;
      font-weight: 800;
      z-index: 2;
      display: flex;
      align-items: center;
      gap: 4px;
      border: 1px solid rgba(255, 255, 255, 0.1);
    }
    .card-content {
      padding: 24px;
      display: flex;
      flex-direction: column;
      flex-grow: 1;
    }
    .card-header-row {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      margin-bottom: 8px;
      gap: 12px;
    }
    .card-title {
      font-size: 1.3rem;
      font-weight: 800;
      color: var(--text-white);
      line-height: 1.2;
    }
    .card-price {
      font-size: 1.45rem;
      font-weight: 800;
      color: var(--primary-orange);
      white-space: nowrap;
    }
    .card-desc {
      font-size: 0.88rem;
      color: var(--text-muted);
      line-height: 1.55;
      margin-bottom: 16px;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .card-meta {
      display: flex;
      align-items: center;
      gap: 12px;
      font-size: 0.8rem;
      color: var(--text-dim);
      margin-bottom: 22px;
      padding-top: 12px;
      border-top: 1px dashed var(--border-dark);
    }
    .card-actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      margin-top: auto;
    }
    .btn-card-detail {
      background: #25252c;
      border: 1px solid var(--border-dark);
      color: var(--text-white);
      padding: 10px 14px;
      border-radius: var(--radius-pill);
      font-size: 0.86rem;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.2s;
      text-align: center;
    }
    .btn-card-detail:hover {
      background: #32323c;
      border-color: rgba(255, 255, 255, 0.2);
    }
    .btn-card-order {
      background: var(--primary-orange);
      color: #ffffff;
      text-decoration: none;
      padding: 10px 14px;
      border-radius: var(--radius-pill);
      font-size: 0.86rem;
      font-weight: 800;
      text-align: center;
      transition: all 0.2s;
      box-shadow: 0 4px 14px rgba(255, 87, 34, 0.35);
      border: none;
    }
    .btn-card-order:hover {
      background: var(--primary-orange-hover);
      box-shadow: 0 8px 20px rgba(255, 87, 34, 0.5);
    }

    /* Sección de Referencia Visual Hamburgesin.png */
    .reference-showcase-section {
      background: #111114;
      border-top: 1px solid var(--border-dark);
      border-bottom: 1px solid var(--border-dark);
      padding: 90px 24px;
    }
    .reference-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 50px;
      align-items: center;
      max-width: 1260px;
      margin: 0 auto;
    }
    .reference-img-card {
      background: var(--bg-surface);
      border: 1px solid var(--border-dark);
      border-radius: 28px;
      padding: 14px;
      box-shadow: 0 25px 60px rgba(0, 0, 0, 0.7);
    }
    .reference-img-card img {
      width: 100%;
      height: auto;
      border-radius: 18px;
      display: block;
    }
    .reference-details h3 {
      font-size: 2.3rem;
      font-weight: 800;
      margin-bottom: 18px;
      line-height: 1.2;
    }
    .reference-details p {
      font-size: 1.05rem;
      color: var(--text-muted);
      line-height: 1.7;
      margin-bottom: 24px;
    }
    .reference-specs-list {
      display: flex;
      flex-direction: column;
      gap: 14px;
      margin-bottom: 30px;
    }
    .spec-item {
      display: flex;
      align-items: flex-start;
      gap: 14px;
      background: var(--bg-surface);
      padding: 14px 18px;
      border-radius: var(--radius-sm);
      border: 1px solid var(--border-dark);
    }
    .spec-icon {
      font-size: 1.4rem;
      line-height: 1;
    }
    .spec-item strong {
      color: var(--text-white);
      display: block;
      font-size: 0.95rem;
    }
    .spec-item span {
      color: var(--text-muted);
      font-size: 0.85rem;
    }

    /* Calidad & Artesanía */
    .features-section {
      padding: 80px 24px;
      max-width: 1260px;
      margin: 0 auto;
    }
    .features-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 30px;
    }
    .feature-box {
      background: var(--bg-surface);
      border: 1px solid var(--border-dark);
      border-radius: var(--radius-card);
      padding: 36px 28px;
      text-align: center;
      transition: transform 0.25s ease;
    }
    .feature-box:hover {
      transform: translateY(-6px);
      border-color: rgba(255, 87, 34, 0.3);
    }
    .feature-icon-wrapper {
      width: 68px;
      height: 68px;
      margin: 0 auto 20px;
      background: var(--primary-orange-subtle);
      border: 1px solid rgba(255, 87, 34, 0.35);
      border-radius: 20px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 2.2rem;
    }
    .feature-box h3 {
      font-size: 1.25rem;
      font-weight: 800;
      margin-bottom: 10px;
      color: var(--text-white);
    }
    .feature-box p {
      font-size: 0.92rem;
      color: var(--text-muted);
      line-height: 1.6;
    }

    /* PWA Banner High Contrast */
    .pwa-banner {
      background: linear-gradient(135deg, #18181c 0%, #2a1610 50%, #18181c 100%);
      border: 1px solid rgba(255, 87, 34, 0.3);
      color: #ffffff;
      border-radius: 32px;
      padding: 60px 48px;
      display: grid;
      grid-template-columns: 1.2fr 0.8fr;
      align-items: center;
      gap: 40px;
      box-shadow: 0 30px 60px rgba(0, 0, 0, 0.7);
      margin: 40px auto 80px;
      max-width: 1260px;
    }
    .pwa-banner h2 {
      font-size: 2.5rem;
      font-weight: 800;
      line-height: 1.2;
      margin-bottom: 16px;
      color: #ffffff;
    }
    .pwa-banner p {
      font-size: 1.08rem;
      color: #d4d4d8;
      line-height: 1.65;
      margin-bottom: 28px;
    }
    .pwa-phone-card {
      background: #0c0c0e;
      color: #ffffff;
      border-radius: 24px;
      padding: 24px;
      display: inline-block;
      text-align: left;
      width: 290px;
      box-shadow: 0 20px 50px rgba(0,0,0,0.8);
      border: 2px solid rgba(255, 87, 34, 0.4);
    }

    /* Modal de Detalles Oscuro */
    .modal-backdrop {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: rgba(0, 0, 0, 0.85);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      z-index: 999;
      align-items: center;
      justify-content: center;
      padding: 20px;
      opacity: 0;
      transition: opacity 0.25s ease;
    }
    .modal-backdrop.active {
      display: flex;
      opacity: 1;
    }
    .modal-box {
      background: #18181c;
      border-radius: 28px;
      max-width: 640px;
      width: 100%;
      overflow: hidden;
      box-shadow: 0 30px 80px rgba(0, 0, 0, 0.9), 0 0 30px rgba(255, 87, 34, 0.2);
      border: 1px solid rgba(255, 255, 255, 0.12);
      animation: modalSlide 0.3s cubic-bezier(0.16, 1, 0.3, 1);
      position: relative;
      max-height: 90vh;
      display: flex;
      flex-direction: column;
    }
    @keyframes modalSlide {
      from { transform: translateY(24px) scale(0.96); }
      to { transform: translateY(0) scale(1); }
    }
    .modal-header-img {
      height: 250px;
      width: 100%;
      position: relative;
      background: #202026;
    }
    .modal-header-img img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .modal-close-btn {
      position: absolute;
      top: 16px;
      right: 16px;
      background: rgba(12, 12, 14, 0.8);
      border: 1px solid rgba(255, 255, 255, 0.2);
      color: #ffffff;
      width: 38px;
      height: 38px;
      border-radius: 50%;
      font-size: 1.25rem;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: transform 0.2s;
    }
    .modal-close-btn:hover {
      transform: scale(1.1);
      background: var(--primary-orange);
    }
    .modal-body {
      padding: 28px;
      overflow-y: auto;
    }
    .modal-badge-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 12px;
    }
    .modal-badge {
      background: var(--primary-orange-subtle);
      color: var(--primary-orange);
      border: 1px solid rgba(255, 87, 34, 0.4);
      padding: 5px 14px;
      border-radius: var(--radius-pill);
      font-size: 0.82rem;
      font-weight: 800;
    }
    .modal-price {
      font-size: 1.7rem;
      font-weight: 800;
      color: var(--primary-orange);
    }
    .modal-title {
      font-size: 1.85rem;
      font-weight: 800;
      margin-bottom: 12px;
      color: var(--text-white);
    }
    .modal-desc {
      font-size: 0.98rem;
      color: var(--text-muted);
      line-height: 1.6;
      margin-bottom: 24px;
    }
    .modal-section-title {
      font-size: 0.82rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--text-dim);
      margin-bottom: 12px;
    }
    .modal-ingredients-list {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-bottom: 24px;
    }
    .ingredient-tag {
      background: #25252c;
      border: 1px solid var(--border-dark);
      padding: 6px 14px;
      border-radius: var(--radius-pill);
      font-size: 0.82rem;
      font-weight: 700;
      color: #e4e4e7;
    }
    .modal-footer {
      padding: 20px 28px;
      background: #141418;
      border-top: 1px solid var(--border-dark);
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 16px;
    }

    /* Footer Dark Obsidian */
    footer {
      background: #08080a;
      border-top: 1px solid var(--border-dark);
      padding: 70px 24px 34px;
    }
    .footer-container {
      max-width: 1260px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: 1.5fr repeat(3, 1fr);
      gap: 48px;
      margin-bottom: 48px;
    }
    .footer-col h5 {
      font-size: 0.95rem;
      font-weight: 800;
      margin-bottom: 18px;
      color: var(--text-white);
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }
    .footer-col ul {
      list-style: none;
    }
    .footer-col li {
      margin-bottom: 10px;
    }
    .footer-col a {
      color: var(--text-muted);
      text-decoration: none;
      font-size: 0.9rem;
      transition: color 0.2s;
    }
    .footer-col a:hover {
      color: var(--primary-orange);
    }
    .footer-bottom {
      border-top: 1px solid var(--border-dark);
      padding-top: 24px;
      font-size: 0.85rem;
      color: var(--text-dim);
      max-width: 1260px;
      margin: 0 auto;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 12px;
    }

    /* Responsive */
    @media (max-width: 960px) {
      .hero { grid-template-columns: 1fr; text-align: center; padding-top: 40px; }
      .hero-title { font-size: 2.6rem; }
      .hero-desc { margin-left: auto; margin-right: auto; }
      .hero-stats-row { justify-content: center; }
      .hero-actions-row { justify-content: center; }
      .reference-grid { grid-template-columns: 1fr; text-align: center; }
      .pwa-banner { grid-template-columns: 1fr; text-align: center; padding: 40px 24px; }
      .footer-container { grid-template-columns: 1fr 1fr; }
    }
    @media (max-width: 640px) {
      .nav-links { display: none; }
      .footer-container { grid-template-columns: 1fr; }
      .card-actions { grid-template-columns: 1fr; }
      .hero-title { font-size: 2.1rem; }
    }
  </style>
</head>
<body>

  <!-- Top Announcement Ribbon -->
  <div class="promo-ribbon">
    <span class="promo-pill-badge">Hamburgesin UI Edition</span>
    <span>🔥 Nuevo estilo visual dark con botones pill ergonómicos &bull; Envío GRATIS con cupón <strong>RAPIDFREE</strong></span>
  </div>

  <!-- Header Navigation -->
  <header>
    <div class="nav-container">
      <a href="/" class="brand">
        <div class="brand-logo-emblem">🍔</div>
        <div class="brand-text">
          <h1>Hamburger Rapid</h1>
          <span>Gourmet Fast-Food</span>
        </div>
      </a>

      <nav class="nav-links">
        <a href="#catalogo" class="nav-link">Nuestras Burgers</a>
        <a href="#calidad" class="nav-link">Parrilla & Ingredientes</a>
        <a href="#referencia-ui" class="nav-link">Inspiración UI</a>
        <a href="#app" class="nav-link">App Móvil</a>
      </nav>

      <div class="nav-actions">
        <a href="/admin/" class="btn-pill-white" title="Panel Administrativo con iDempiere ERP">
          <span>⚙️</span> Panel Admin
        </a>
        <a href="/app/" class="btn-pill-orange">
          <span>📱</span> Pedir en App PWA
        </a>
      </div>
    </div>
  </header>

  <!-- Hero Section -->
  <section class="hero">
    <div class="hero-content">
      <div class="hero-badge-row">
        <span>✨ NUEVA EXPERIENCIA HAMBURGESIN UI</span>
      </div>
      <h2 class="hero-title">
        Hamburguesas de verdad, <span class="highlight-orange">flameadas al carbón</span> y listas en minutos.
      </h2>
      <p class="hero-desc">
        Carne 100% Angus certificada, pan brioche horneado a diario y salsas maestras. Rediseñado con la estética dark premium, botones pill de alta interacción y contraste cálido de la referencia <strong>Hamburgesin UI</strong>.
      </p>

      <div class="hero-stats-row">
        <div class="stat-pill">⏱️ Entrega en &lt; 25 min</div>
        <div class="stat-pill">🔥 Roble & Carbón Vivo</div>
        <div class="stat-pill">⭐ 4.9/5 en +1,200 reseñas</div>
      </div>

      <div class="hero-actions-row">
        <a href="/app/" class="btn-pill-orange" style="padding:14px 32px; font-size:1.05rem;">
          <span>🍔</span> Pedir en App PWA
        </a>
        <a href="#catalogo" class="btn-pill-white" style="padding:14px 28px; font-size:1.05rem;">
          <span>📋</span> Ver 10 Obras Maestras
        </a>
      </div>
    </div>

    <!-- Hero Mockup Phone inspirada en Hamburgesin.png -->
    <div class="hero-phone-mockup">
      <div class="mockup-top-notch">
        <span>📶 LTE 5G</span>
        <span>🍔 Hamburger Rapid App</span>
        <span>100% 🔋</span>
      </div>

      <div class="mockup-hero-img-box">
        <span class="mockup-badge">👑 Destacada del Día</span>
        <img src="https://images.unsplash.com/photo-1568901346375-23c9450c58cd?w=700&auto=format&fit=crop&q=80" alt="Rey de las Burgers" />
      </div>

      <div class="mockup-section-title">
        <span>Especialidades del Chef <span class="dot-indicator"></span></span>
        <span style="font-size:0.75rem; color:var(--primary-orange); cursor:pointer;">Ver todas &rarr;</span>
      </div>

      <div class="mockup-quick-grid">
        <div class="mockup-quick-card">
          <img src="https://images.unsplash.com/photo-1586190848861-99aa4a171e90?w=200&auto=format&fit=crop&q=80" alt="Clásica" />
          <span>Real Clásica</span>
          <div class="price">$10.99</div>
        </div>
        <div class="mockup-quick-card">
          <img src="https://images.unsplash.com/photo-1550547660-d9450f859349?w=200&auto=format&fit=crop&q=80" alt="Real Doble" />
          <span>Real Doble</span>
          <div class="price">$13.99</div>
        </div>
        <div class="mockup-quick-card">
          <img src="https://images.unsplash.com/photo-1572802419224-296b0aeee0d9?w=200&auto=format&fit=crop&q=80" alt="Doble Especial" />
          <span>Doble Especial</span>
          <div class="price">$14.50</div>
        </div>
      </div>

      <div class="mockup-actions-footer">
        <a href="/app/" class="btn-pill-orange" style="width:100%; justify-content:center; padding:10px; font-size:0.85rem;">
          <span>⚡</span> Abrir Menú Interactivo
        </a>
      </div>
    </div>
  </section>

  <!-- Buscador Blanco Pill de Referencia (Pantalla 3 de Hamburgesin.png) -->
  <div class="search-section-wrap">
    <div class="search-pill-container">
      <span class="search-icon-btn">🔍</span>
      <input type="text" id="burgerSearchInput" placeholder="Buscar hamburguesa por nombre, ingrediente o especialidad (ej. Trufa, Cheddar, Angus)..." />
      <button id="clearSearchBtn" class="clear-search-btn" title="Limpiar búsqueda">&times;</button>
    </div>
  </div>

  <!-- Catálogo de 10 Hamburguesas Maestras -->
  <section id="catalogo">
    <div class="section-header">
      <span class="section-pill-tag">Menú Comercial Completo</span>
      <h3 class="section-title">10 Hamburguesas Maestras <span class="dot-indicator"></span></h3>
      <p class="section-subtitle">
        Desde las recetas más veneradas de la parrilla clásica hasta creaciones gourmets cargadas de trufa negra, quesos madurados y salsas artesanales.
      </p>
    </div>

    <!-- Category Filters -->
    <div class="filter-pills-bar">
      <button class="filter-pill-btn active" data-filter="all">Todas (10)</button>
      <button class="filter-pill-btn" data-filter="Especiales">Especiales de la Casa</button>
      <button class="filter-pill-btn" data-filter="Clásicas">Clásicas & Dobles</button>
      <button class="filter-pill-btn" data-filter="Gourmet">Gourmet & Pollo</button>
    </div>

    <!-- 10 Burger Cards -->
    <div class="catalog-grid" id="burgerGrid">
      {burgers.map((b) => (
        <article class="burger-card" data-category={b.category} data-id={b.id} data-name={b.name.toLowerCase()} data-ingredients={b.ingredients.join(' ').toLowerCase()}>
          <div class="card-img-wrap">
            <span class="specialty-badge">{b.specialtyBadge}</span>
            <span class="rating-badge">★ {b.rating}</span>
            <img src={b.image} alt={b.name} loading="lazy" />
          </div>

          <div class="card-content">
            <div class="card-header-row">
              <h4 class="card-title">{b.name}</h4>
              <span class="card-price">${Number(b.price || 0).toFixed(2)}</span>
            </div>

            <p class="card-desc">{b.description}</p>

            <div class="card-meta">
              <span>⏱️ {b.prepTime}</span>
              <span>&bull;</span>
              <span>🔥 {b.calories}</span>
              <span>&bull;</span>
              <span>{b.category}</span>
            </div>

            <div class="card-actions">
              <button
                class="btn-card-detail"
                data-burger={JSON.stringify(b)}
              >
                🔍 Ver detalles
