<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Hamburger Rapid &bull; Hamburguesas Auténticas al Carbón</title>
  <meta name="description" content="Primera versión comercial de Hamburger Rapid. Hamburguesas clásicas y especiales de alta gama con pan brioche artesanal y carne Angus certificada." />
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Playfair+Display:ital,wght@0,700;1,700&display=swap" rel="stylesheet">
  
  <style>
    :root {
      --bg: #faf8f5;
      --surface: #ffffff;
      --surface-subtle: #f7f3ec;
      --border: #f1e8dc;
      --border-accent: #fed7aa;
      --text: #1c1917;
      --text-muted: #78716c;
      --primary: #d97706;
      --primary-hover: #b45309;
      --primary-subtle: #fef3c7;
      --flame: #ea580c;
      --shadow-sm: 0 2px 8px rgba(217, 119, 6, 0.05);
      --shadow-md: 0 10px 25px -5px rgba(217, 119, 6, 0.08), 0 8px 10px -6px rgba(0, 0, 0, 0.03);
      --shadow-lg: 0 20px 35px -10px rgba(217, 119, 6, 0.12), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
      --radius: 16px;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    
    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
      background-color: var(--bg);
      color: var(--text);
      line-height: 1.6;
      overflow-x: hidden;
      -webkit-font-smoothing: antialiased;
    }

    /* Top Announcement Bar */
    .promo-bar {
      background: linear-gradient(90deg, #d97706, #ea580c);
      color: #ffffff;
      text-align: center;
      padding: 8px 16px;
      font-size: 0.85rem;
      font-weight: 700;
      letter-spacing: 0.02em;
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 12px;
    }
    .promo-badge {
      background: rgba(255, 255, 255, 0.25);
      padding: 2px 8px;
      border-radius: 9999px;
      font-size: 0.75rem;
      text-transform: uppercase;
    }

    /* Header & Navigation */
    header {
      background: rgba(255, 255, 255, 0.95);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--border);
      position: sticky;
      top: 0;
      z-index: 100;
      transition: all 0.3s;
    }
    .nav-container {
      max-width: 1240px;
      margin: 0 auto;
      padding: 16px 24px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .brand {
      display: flex;
      align-items: center;
      gap: 12px;
      text-decoration: none;
      color: var(--text);
    }
    .brand-icon {
      font-size: 2rem;
      line-height: 1;
      filter: drop-shadow(0 4px 8px rgba(217, 119, 6, 0.3));
    }
    .brand-text h1 {
      font-size: 1.35rem;
      font-weight: 800;
      letter-spacing: -0.02em;
      color: var(--text);
      line-height: 1.1;
    }
    .brand-text span {
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--primary);
    }
    .nav-links {
      display: flex;
      align-items: center;
      gap: 28px;
    }
    .nav-link {
      text-decoration: none;
      color: var(--text-muted);
      font-weight: 600;
      font-size: 0.92rem;
      transition: color 0.2s;
    }
    .nav-link:hover { color: var(--primary); }
    .nav-actions {
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .btn-admin {
      background: var(--surface-subtle);
      border: 1px solid var(--border);
      color: var(--text);
      text-decoration: none;
      padding: 9px 16px;
      border-radius: 10px;
      font-size: 0.88rem;
      font-weight: 600;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: all 0.2s;
    }
    .btn-admin:hover {
      background: #eee7dc;
      border-color: #e0d3c1;
    }
    .btn-pwa-cta {
      background: linear-gradient(135deg, #d97706, #ea580c);
      color: #ffffff;
      text-decoration: none;
      padding: 10px 20px;
      border-radius: 10px;
      font-size: 0.9rem;
      font-weight: 700;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      box-shadow: 0 6px 18px rgba(217, 119, 6, 0.25);
      transition: all 0.2s;
    }
    .btn-pwa-cta:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 24px rgba(217, 119, 6, 0.35);
    }

    /* Hero Section */
    .hero {
      padding: 70px 24px 60px;
      max-width: 1240px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: 1.15fr 0.85fr;
      align-items: center;
      gap: 48px;
    }
    .hero-tag {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: var(--primary-subtle);
      color: #92400e;
      border: 1px solid #fde68a;
      padding: 6px 14px;
      border-radius: 9999px;
      font-size: 0.82rem;
      font-weight: 700;
      margin-bottom: 20px;
    }
    .hero-title {
      font-size: 3.4rem;
      font-weight: 800;
      line-height: 1.12;
      letter-spacing: -0.03em;
      margin-bottom: 20px;
      color: #1c1917;
    }
    .hero-title .highlight {
      background: linear-gradient(135deg, #d97706, #ea580c);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    .hero-description {
      font-size: 1.15rem;
      color: var(--text-muted);
      line-height: 1.7;
      margin-bottom: 32px;
      max-width: 580px;
    }
    .hero-features {
      display: flex;
      flex-wrap: wrap;
      gap: 20px;
      margin-bottom: 36px;
    }
    .feature-pill {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 0.88rem;
      font-weight: 600;
      color: var(--text);
      background: var(--surface);
      padding: 8px 16px;
      border-radius: 9999px;
      border: 1px solid var(--border);
      box-shadow: var(--shadow-sm);
    }
    .hero-buttons {
      display: flex;
      gap: 16px;
      flex-wrap: wrap;
    }
    .btn-hero-primary {
      background: linear-gradient(135deg, #d97706, #ea580c);
      color: white;
      text-decoration: none;
      padding: 14px 28px;
      border-radius: 12px;
      font-size: 1.05rem;
      font-weight: 700;
      display: inline-flex;
      align-items: center;
      gap: 10px;
      box-shadow: 0 10px 25px rgba(217, 119, 6, 0.3);
      transition: all 0.25s;
    }
    .btn-hero-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 14px 30px rgba(217, 119, 6, 0.4);
    }
    .btn-hero-secondary {
      background: var(--surface);
      color: var(--text);
      text-decoration: none;
      padding: 14px 26px;
      border-radius: 12px;
      font-size: 1.05rem;
      font-weight: 600;
      border: 1px solid var(--border);
      display: inline-flex;
      align-items: center;
      gap: 8px;
      transition: all 0.2s;
    }
    .btn-hero-secondary:hover {
      background: var(--surface-subtle);
      border-color: #e5d7c3;
    }

    /* Hero Visual Card */
    .hero-visual {
      position: relative;
    }
    .hero-img-box {
      position: relative;
      border-radius: 24px;
      overflow: hidden;
      box-shadow: var(--shadow-lg);
      border: 4px solid #ffffff;
      aspect-ratio: 4 / 3.4;
    }
    .hero-img-box img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 0.5s ease;
    }
    .hero-img-box:hover img {
      transform: scale(1.04);
    }
    .floating-card {
      position: absolute;
      bottom: -18px;
      left: -18px;
      background: rgba(255, 255, 255, 0.95);
      backdrop-filter: blur(8px);
      border: 1px solid var(--border-accent);
      padding: 14px 18px;
      border-radius: 16px;
      box-shadow: var(--shadow-md);
      display: flex;
      align-items: center;
      gap: 14px;
    }
    .floating-avatar {
      font-size: 2rem;
      background: var(--primary-subtle);
      width: 48px;
      height: 48px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .floating-text h4 {
      font-size: 0.95rem;
      font-weight: 800;
      color: var(--text);
    }
    .floating-text p {
      font-size: 0.78rem;
      color: var(--text-muted);
    }

    /* Section Styles */
    section {
      padding: 80px 24px;
      max-width: 1240px;
      margin: 0 auto;
    }
    .section-header {
      text-align: center;
      max-width: 720px;
      margin: 0 auto 52px;
    }
    .section-badge {
      display: inline-block;
      background: var(--primary-subtle);
      color: #92400e;
      border: 1px solid #fde68a;
      padding: 5px 14px;
      border-radius: 9999px;
      font-size: 0.8rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 12px;
    }
    .section-title {
      font-size: 2.6rem;
      font-weight: 800;
      letter-spacing: -0.02em;
      color: var(--text);
      line-height: 1.2;
      margin-bottom: 14px;
    }
    .section-subtitle {
      font-size: 1.08rem;
      color: var(--text-muted);
    }

    /* Filter Pills */
    .filter-wrapper {
      display: flex;
      justify-content: center;
      gap: 10px;
      margin-bottom: 40px;
      flex-wrap: wrap;
    }
    .filter-btn {
      background: var(--surface);
      border: 1px solid var(--border);
      padding: 9px 20px;
      border-radius: 9999px;
      font-size: 0.9rem;
      font-weight: 600;
      color: var(--text-muted);
      cursor: pointer;
      transition: all 0.2s;
    }
    .filter-btn:hover, .filter-btn.active {
      background: var(--text);
      color: #ffffff;
      border-color: var(--text);
    }

    /* Burger Catalog Grid */
    .catalog-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: 28px;
    }
    .burger-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      overflow: hidden;
      box-shadow: var(--shadow-sm);
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
      display: flex;
      flex-direction: column;
      position: relative;
    }
    .burger-card:hover {
      transform: translateY(-6px);
      box-shadow: var(--shadow-lg);
      border-color: var(--border-accent);
    }
    .card-img-wrapper {
      position: relative;
      aspect-ratio: 16 / 11;
      overflow: hidden;
      background: #f1ede4;
    }
    .card-img-wrapper img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.4s ease;
    }
    .burger-card:hover .card-img-wrapper img {
      transform: scale(1.06);
    }
    .specialty-badge {
      position: absolute;
      top: 14px;
      left: 14px;
      background: rgba(255, 255, 255, 0.95);
      backdrop-filter: blur(6px);
      color: #92400e;
      border: 1px solid #fde68a;
      padding: 5px 12px;
      border-radius: 9999px;
      font-size: 0.78rem;
      font-weight: 700;
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.08);
      z-index: 2;
    }
    .rating-badge {
      position: absolute;
      top: 14px;
      right: 14px;
      background: rgba(28, 25, 23, 0.85);
      color: #fef08a;
      backdrop-filter: blur(6px);
      padding: 4px 10px;
      border-radius: 9999px;
      font-size: 0.76rem;
      font-weight: 700;
      z-index: 2;
      display: flex;
      align-items: center;
      gap: 4px;
    }
    .card-content {
      padding: 22px;
      display: flex;
      flex-direction: column;
      flex-grow: 1;
    }
    .card-header-row {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      margin-bottom: 8px;
    }
    .card-title {
      font-size: 1.25rem;
      font-weight: 800;
      color: var(--text);
      line-height: 1.2;
    }
    .card-price {
      font-size: 1.35rem;
      font-weight: 800;
      color: var(--primary);
      white-space: nowrap;
    }
    .card-desc {
      font-size: 0.88rem;
      color: var(--text-muted);
      line-height: 1.5;
      margin-bottom: 16px;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .card-meta {
      display: flex;
      align-items: center;
      gap: 14px;
      font-size: 0.8rem;
      color: #a8a29e;
      margin-bottom: 20px;
      padding-top: 10px;
      border-top: 1px dashed var(--border);
    }
    .card-actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      margin-top: auto;
    }
    .btn-detail {
      background: var(--surface-subtle);
      border: 1px solid var(--border);
      color: var(--text);
      padding: 10px;
      border-radius: 10px;
      font-size: 0.88rem;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.2s;
      text-align: center;
    }
    .btn-detail:hover {
      background: #ece3d4;
      border-color: #dfceb7;
    }
    .btn-order-pwa {
      background: var(--primary);
      color: white;
      text-decoration: none;
      padding: 10px;
      border-radius: 10px;
      font-size: 0.88rem;
      font-weight: 700;
      text-align: center;
      transition: all 0.2s;
      box-shadow: 0 4px 12px rgba(217, 119, 6, 0.25);
    }
    .btn-order-pwa:hover {
      background: var(--primary-hover);
      box-shadow: 0 6px 16px rgba(217, 119, 6, 0.35);
    }

    /* Features Grid */
    .features-section {
      background: var(--surface);
      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
