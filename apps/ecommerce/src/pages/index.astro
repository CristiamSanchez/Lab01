  <!-- Client-side Interactive Script -->
  <script is:inline>
    // Category Filtering & Live Search
    const filterButtons = document.querySelectorAll('.filter-pill-btn');
    const burgerCards = document.querySelectorAll('.burger-card');
    const searchInput = document.getElementById('burgerSearchInput');
    const clearSearchBtn = document.getElementById('clearSearchBtn');
    const noResultsMsg = document.getElementById('noResultsMsg');

    let currentCategory = 'all';
    let currentSearchTerm = '';

    function applyFilters() {
      let visibleCount = 0;
      burgerCards.forEach(card => {
        const cat = card.dataset.category;
        const name = card.dataset.name || '';
        const ingredients = card.dataset.ingredients || '';

        const matchesCategory = (currentCategory === 'all') ||
          (currentCategory === 'Gourmet' && (cat === 'Gourmet' || cat === 'Pollo Crispy')) ||
          (currentCategory === cat);

        const matchesSearch = !currentSearchTerm || 
          name.includes(currentSearchTerm) || 
          ingredients.includes(currentSearchTerm) ||
          cat.toLowerCase().includes(currentSearchTerm);

        if (matchesCategory && matchesSearch) {
          card.style.display = 'flex';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      if (noResultsMsg) {
        noResultsMsg.style.display = visibleCount === 0 ? 'block' : 'none';
      }
    }

    // Category button click
    filterButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        filterButtons.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        currentCategory = btn.dataset.filter;
        applyFilters();
      });
    });

    // Real-time Search input
    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        currentSearchTerm = e.target.value.trim().toLowerCase();
        if (clearSearchBtn) {
          clearSearchBtn.style.display = currentSearchTerm ? 'inline-flex' : 'none';
        }
        applyFilters();
      });
    }

    if (clearSearchBtn) {
      clearSearchBtn.addEventListener('click', () => {
        if (searchInput) {
          searchInput.value = '';
          currentSearchTerm = '';
          clearSearchBtn.style.display = 'none';
          applyFilters();
          searchInput.focus();
        }
      });
    }

    // Modal Interaction
    const modal = document.getElementById('burgerModal');
    const modalCloseBtn = document.getElementById('modalCloseBtn');
    const modalImg = document.getElementById('modalImg');
    const modalSpecialty = document.getElementById('modalSpecialty');
    const modalPrice = document.getElementById('modalPrice');
    const modalTitle = document.getElementById('modalTitle');
    const modalDesc = document.getElementById('modalDesc');
    const modalIngredients = document.getElementById('modalIngredients');
    const modalPrep = document.getElementById('modalPrep');
    const modalCal = document.getElementById('modalCal');
    const modalRating = document.getElementById('modalRating');

    document.querySelectorAll('.btn-card-detail').forEach(btn => {
      btn.addEventListener('click', () => {
        try {
          const burger = JSON.parse(btn.dataset.burger);
          modalImg.src = burger.image;
          modalSpecialty.textContent = burger.specialtyBadge;
          modalPrice.textContent = `$${Number(burger.price || 0).toFixed(2)}`;
          modalTitle.textContent = burger.name;
          modalDesc.textContent = burger.description;
          modalPrep.textContent = burger.prepTime || '10 min';
          modalCal.textContent = burger.calories || '750 kcal';
          modalRating.textContent = `${burger.rating} / 5.0`;

          // Clear and fill ingredients
          modalIngredients.innerHTML = '';
          (burger.ingredients || []).forEach(ing => {
            const tag = document.createElement('span');
            tag.className = 'ingredient-tag';
            tag.textContent = ing;
            modalIngredients.appendChild(tag);
          });

          modal.classList.add('active');
        } catch (e) {
          console.error('Error opening burger details:', e);
        }
      });
    });

    function closeModal() {
      if (modal) modal.classList.remove('active');
    }

    if (modalCloseBtn) modalCloseBtn.addEventListener('click', closeModal);
    if (modal) {
      modal.addEventListener('click', (e) => {
        if (e.target === modal) closeModal();
      });
    }
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeModal();
    });
  </script>
